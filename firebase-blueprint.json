{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public profile for a FLASH user (zero PII).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "bio": {
          "type": "string",
          "maxLength": 160
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "displayName", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Private PII and preferences strictly isolated to the owning user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "pushEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "pushEnabled", "createdAt", "updatedAt"]
    },
    "UsernameClaim": {
      "title": "UsernameClaim",
      "description": "Unique handle reservation mapping username to user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24,
          "pattern": "^[a-z0-9_]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "createdAt"]
    },
    "Friendship": {
      "title": "Friendship",
      "description": "Bidirectional friendship connection between two FLASH users.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "requesterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requesterName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "requesterUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "requesterPhoto": {
          "type": "string",
          "maxLength": 1000
        },
        "recipientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "recipientUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "recipientPhoto": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "participantIds",
        "requesterId",
        "recipientId",
        "requesterName",
        "requesterUsername",
        "recipientName",
        "recipientUsername",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Instant": {
      "title": "Instant",
      "description": "View-once ephemeral photo instant with strict terminal viewing state.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "senderUsername": {
          "type": "string",
          "minLength": 3,
          "maxLength": 24
        },
        "senderPhoto": {
          "type": "string",
          "maxLength": 1000
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "participantIds": {
          "type": "array"
        },
        "caption": {
          "type": "string",
          "maxLength": 160
        },
        "storagePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "durationSeconds": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["unopened", "viewing", "viewed", "expired"]
        },
        "viewedBy": {
          "type": "string",
          "maxLength": 128
        },
        "receivedAt": {
          "type": "string",
          "format": "date-time"
        },
        "viewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "senderId",
        "senderName",
        "senderUsername",
        "recipientId",
        "recipientName",
        "participantIds",
        "caption",
        "storagePath",
        "durationSeconds",
        "status",
        "viewedBy",
        "receivedAt",
        "expiresAt",
        "updatedAt"
      ]
    },
    "Message": {
      "title": "Message",
      "description": "Direct message between accepted friends.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantIds": {
          "type": "array"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "instantId": {
          "type": "string",
          "maxLength": 128
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "senderId",
        "recipientId",
        "participantIds",
        "text",
        "instantId",
        "read",
        "createdAt",
        "updatedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app activity notification for friend requests, instants, and views.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "recipientId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "actorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "type": {
          "type": "string",
          "enum": ["friend_request", "friend_accepted", "instant_received", "instant_viewed", "message"]
        },
        "entityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "recipientId",
        "actorId",
        "actorName",
        "type",
        "entityId",
        "message",
        "read",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Public user profiles keyed by Firebase Auth UID (no PII)."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Private PII and notification preferences strictly restricted to the profile owner."
    },
    "/usernames/{username}": {
      "schema": { "$ref": "#/entities/UsernameClaim" },
      "description": "Unique username handle reservation mapping."
    },
    "/friendships/{friendshipId}": {
      "schema": { "$ref": "#/entities/Friendship" },
      "description": "Friend requests and accepted friendships between pairs of users."
    },
    "/instants/{instantId}": {
      "schema": { "$ref": "#/entities/Instant" },
      "description": "Ephemeral view-once photo instants with terminal viewed/expired state locking."
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Direct messages exchanged between accepted friends."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User-scoped notifications for instants, friend requests, and views."
    }
  }
}
