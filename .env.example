# APP_URL: Public HTTPS URL where FLASH is hosted (e.g. Render custom domain).
APP_URL="http://localhost:3000"

# PORT: Port bound by the Express server (Render injects PORT automatically; local default 3000).
PORT="3000"

# NODE_ENV: "development" or "production"
NODE_ENV="development"

# VITE_FIREBASE_PROJECT_ID (Optional override when deploying outside AI Studio)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""

# Firebase App Check (Optional: reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=""

# Optional: Full Firebase Service Account JSON (for production server-side Storage/Firestore auto-deletion on Render)
FIREBASE_SERVICE_ACCOUNT_JSON=""
